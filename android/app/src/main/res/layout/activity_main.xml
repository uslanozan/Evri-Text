<?xml version="1.0" encoding="utf-8"?>
<!-- Overscan: TVs crop the outer edge of the picture, so nothing meaningful may
     sit closer than ~5% to the border. That is what the 48dp/27dp padding is. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp"
    android:clipToPadding="false"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.EvriText.Screen" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:textAppearance="@style/TextAppearance.EvriText.RowValue"
            tools:text="Bağlı değil" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.EvriText.Section" />

        <TextView
            android:id="@+id/subtitlePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/subtitle_preview_text"
            android:textColor="@color/subtitle_text"
            android:textSize="@dimen/subtitle_text_size" />

        <!-- First row on purpose: it is the one thing anyone in the house will ever
             need to touch, and the D-pad lands here on open. -->
        <include
            android:id="@+id/rowEnabled"
            layout="@layout/item_setting_switch" />

        <include
            android:id="@+id/rowPairing"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowApiKey"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowSubtitleColor"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowSubtitleSize"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowSubtitleBackground"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowSubtitlePosition"
            layout="@layout/item_setting_row" />

    </LinearLayout>

</ScrollView>
