<?xml version="1.0" encoding="utf-8"?>
<!-- Overscan: TVs crop the outer edge of the picture, so nothing meaningful may
     sit closer than ~5% to the border. That is what the 48dp/27dp padding is. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp"
    android:paddingBottom="27dp"
    android:clipToPadding="false"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.EvriText.Screen" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:textAppearance="@style/TextAppearance.EvriText.RowValue"
            tools:text="Bağlı değil" />

        <!-- Phase 1 step C only: proves the Lounge port works before anything is
             built on top of it. Comes out once the overlay renders real subtitles. -->
        <TextView
            android:id="@+id/probeLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:padding="16dp"
            android:background="@drawable/row_background"
            android:fontFamily="monospace"
            android:textColor="@color/primary"
            android:textSize="16sp"
            tools:text="video —\npozisyon —" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.EvriText.Section" />

        <!-- First row on purpose: it is the one thing anyone in the house will ever
             need to touch, and the D-pad lands here on open. -->
        <include
            android:id="@+id/rowEnabled"
            layout="@layout/item_setting_switch" />

        <include
            android:id="@+id/rowApiKey"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowTargetLang"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowModel"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowOffset"
            layout="@layout/item_setting_row" />

        <include
            android:id="@+id/rowCache"
            layout="@layout/item_setting_row" />

    </LinearLayout>

</ScrollView>
