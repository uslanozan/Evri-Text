<?xml version="1.0" encoding="utf-8"?>
<!-- Same row shape as the others so the list reads as one column, but with a switch
     instead of a value. The switch is not focusable itself: the row takes the focus
     and OK flips it, because on a TV the focus has to stay on one thing per row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    style="@style/Widget.EvriText.Row">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/switchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EvriText.RowTitle"
            tools:text="Altyazı" />

        <TextView
            android:id="@+id/switchSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.EvriText.RowValue"
            tools:text="YouTube videolarına Türkçe altyazı bindirilir" />

    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:clickable="false"
        android:focusable="false"
        android:duplicateParentState="true" />

</LinearLayout>
