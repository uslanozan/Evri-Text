# Copy to .env and fill in. .env is gitignored.

# Mi Box S IP address on your LAN. Used for both `adb connect` and TvOverlay's
# HTTP port. Find it: Settings > Network & Internet > (your Wi-Fi) > IP address
TV_IP=192.168.1.50

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cheap default. gemini-2.5-flash-lite is closed to new API keys (404 NOT_FOUND),
# so Flash-Lite 3.5 is the baseline. Newer Flash/Flash-Lite models work too.
GEMINI_MODEL=gemini-3.5-flash-lite

TARGET_LANG=tr
