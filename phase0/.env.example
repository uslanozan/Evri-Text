# Copy to .env and fill in. .env is gitignored.

# Mi Box S IP address on your LAN. Used for both `adb connect` and TvOverlay's
# HTTP port. Find it: Settings > Network & Internet > (your Wi-Fi) > IP address
TV_IP=192.168.1.50

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash-lite is closed to new API keys (404 NOT_FOUND).
# gemini-3.5-flash-lite is the cheapest that works; gemini-3.6-flash is notably
# more consistent about dialogue dashes and fixing ASR mishearings.
GEMINI_MODEL=gemini-3.6-flash

# Sentences per translation request. Smaller = the model stays more consistent
# about speaker turns, at the cost of more requests (free tier: 15/minute).
CHUNK_SIZE=30

TARGET_LANG=tr
