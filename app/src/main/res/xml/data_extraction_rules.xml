<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Credentials and pairing state must never leave the TV through backup. -->
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
    </device-transfer>
</data-extraction-rules>
